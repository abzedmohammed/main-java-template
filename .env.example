DB_URL=jdbc:postgresql://localhost:5432/main_java_template
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Base64-encoded secret, minimum 32-byte key material before encoding
APP_JWT_ACCESS_SECRET=REPLACE_WITH_BASE64_SECRET
APP_JWT_ACCESS_MINUTES=15

# OTP auth. TTL is also returned to the client as `otpTimer` (minutes).
# HMAC key for hashing OTP codes (>= 32 chars). Generate: openssl rand -base64 36
APP_OTP_SECRET=REPLACE_WITH_OTP_SECRET
APP_OTP_TTL_MINUTES=5
APP_OTP_MAX_ATTEMPTS=5
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15

# Comma-separated allowed CORS origin patterns
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional admin bootstrap. Set the email to promote/create an ADMIN on startup;
# provide the password to create the account if it does not already exist.
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=ChangeMe123!

# Optional social login support (requires spring.security.oauth2.client.* config)
APP_SOCIAL_AUTH_ENABLED=false

# Email templates: {{appName}}, {{supportEmail}}, and the CTA link
APP_NAME=Main Java Template
APP_SUPPORT_EMAIL=support@example.com
APP_FRONTEND_LOGIN_URL=http://localhost:5173/login
APP_FRONTEND_OAUTH_SUCCESS_URL=http://localhost:5173/oauth/success
APP_MAIL_FROM=no-reply@example.com

# Mail server (use Mailhog/Mailpit locally)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false

APP_RABBITMQ_ENABLED=false
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
