{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/dev-reload-hook.sh\"",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Hot-reloading server"
          }
        ]
      }
    ]
  }
}
